---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import LogosBar from '../components/sections/LogosBar.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import DashboardPreview from '../components/sections/DashboardPreview.astro';
import Integrations from '../components/sections/Integrations.astro';
import Pricing from '../components/sections/Pricing.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTA from '../components/sections/CTA.astro';
import Footer from '../components/sections/Footer.astro';
---

<BaseLayout
  title="Brightdash | Painel de performance comercial em tempo real"
  description="O Brightdash conecta ao seu CRM e reúne ranking de vendedores e SDRs, reuniões agendadas, metas, comissões e conversão em um único painel em tempo real."
>
  <Header />
  <main>
    <Hero />
    <LogosBar />
    <Features />
    <HowItWorks />
    <DashboardPreview />
    <Integrations />
    <Pricing />
    <Testimonials />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
