---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  class?: string;
  external?: boolean;
}

const { href, variant = 'primary', size = 'md', class: className = '', external = false } = Astro.props;

const base = 'transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2';

const variants = {
  primary:
    'inline-flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700 text-white rounded-lg font-medium shadow-sm',
  secondary:
    'inline-flex items-center justify-center gap-2 bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg font-medium',
};

const sizes = {
  md: 'px-4 py-2',
  lg: 'px-6 py-3 text-base',
};
---

<a
  href={href}
  class={`${variants[variant]} ${sizes[size]} ${base} ${className}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>
