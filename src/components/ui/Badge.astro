---
interface Props {
  variant?: 'info' | 'positive' | 'negative' | 'warning';
  class?: string;
}

const { variant = 'info', class: className = '' } = Astro.props;

const variants = {
  info: 'bg-sky-100 text-sky-800',
  positive: 'bg-emerald-50 text-emerald-700',
  negative: 'bg-rose-50 text-rose-700',
  warning: 'bg-amber-50 text-amber-700',
};
---

<span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium ${variants[variant]} ${className}`}>
  <slot />
</span>
