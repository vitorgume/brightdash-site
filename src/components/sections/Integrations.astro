---
import { integrations } from '../../data/integrations';
---

<section id="integracoes" class="bg-slate-50 py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl">
      <span class="text-sm font-semibold uppercase tracking-wide text-teal-600">Integrações</span>
      <h2 class="mt-4 text-3xl md:text-4xl font-semibold tracking-tight text-slate-900">
        Conecte o CRM que sua equipe já usa
      </h2>
      <p class="mt-4 text-base md:text-lg text-slate-500 font-medium">
        Integração nativa e segura, sem precisar migrar dados ou mudar a rotina do time comercial.
      </p>
    </div>

    <!-- Container do Carrossel -->
    <div class="mt-12 relative flex overflow-hidden mask-edges group">
      
      <!-- Primeira Lista -->
      <div class="flex w-max animate-infinite-scroll group-hover:[animation-play-state:paused]">
        {
          integrations.map((integration) => (
            <div class="mx-2 w-40 md:w-48 flex-shrink-0 bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex items-center justify-center">
              <img
                src={integration.logo}
                alt={integration.name}
                width="140"
                height="40"
                class="h-8 w-auto"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
      
      <!-- Segunda Lista (Cópia exata para o loop infinito) -->
      <div class="flex w-max animate-infinite-scroll group-hover:[animation-play-state:paused]" aria-hidden="true">
        {
          integrations.map((integration) => (
            <div class="mx-2 w-40 md:w-48 flex-shrink-0 bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex items-center justify-center">
              <img
                src={integration.logo}
                alt={integration.name}
                width="140"
                height="40"
                class="h-8 w-auto"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>

    </div>

    <p class="mt-6 text-sm text-slate-500">
      Não encontrou seu CRM? <a href="#cta" class="text-teal-600 font-medium hover:text-teal-700">fale com a gente</a>.
    </p>
  </div>
</section>

<style>
  /* Define a animação de rolagem contínua */
  .animate-infinite-scroll {
    animation: scroll 25s linear infinite;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  /* (Opcional) Adiciona um efeito de degradê (fade) nas bordas do carrossel */
  .mask-edges {
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
</style>